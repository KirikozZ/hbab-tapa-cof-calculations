Using LAMMPS interface, version "2025-05-12".

compute           cpull pull com
variable          zcpull equal c_cpull[3]

region            bottom block EDGE EDGE EDGE EDGE 134 144
group             resgrp region bottom
1544 atoms in group resgrp
group             resgrp include molecule
1860 atoms in group resgrp
fix               restraint resgrp spring/self 0.1

#fix               3 pboth setforce 0.0 0.0 NULL
#fix               4 pbe aveforce 0.0 0.0 0
#fix               5 pup aveforce 0.0 0.0 0
#fix               6 pboth nve

thermo            1000
thermo_style      custom step cpu etotal temp v_zcpull
thermo_modify     flush yes

run               30000000

